{
  "name": "photo-to-coloring-page",
  "version": "1.0.0",
  "description": "Turn a photo into printable black-and-white coloring page line art, entirely in the browser. Zero dependencies.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./worker": "./src/worker.js"
  },
  "files": [
    "src"
  ],
  "sideEffects": [
    "./src/worker.js"
  ],
  "scripts": {
    "test": "node --test",
    "example": "node scripts/make-example.mjs",
    "demo": "python3 -m http.server 8080"
  },
  "keywords": [
    "coloring-page",
    "line-art",
    "edge-detection",
    "image-processing",
    "photo-to-sketch",
    "web-worker",
    "canvas",
    "zero-dependency"
  ],
  "author": "Jack Ships",
  "license": "MIT",
  "private": false,
  "engines": {
    "node": ">=18"
  }
}
